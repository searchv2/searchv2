@startuml deployment-diagram
title SearchV2 - UML deployment diagram (Kubernetes on Minikube)
skinparam nodesep 40
skinparam ranksep 50

' Notation follows Modul 7 "Miljoebeskrivelser": nodes are runtime environments, <<container>> are
' runtime units, <<image>> are the deployed artifacts, <<volume>>/<<configmap>>/<<secret>> are data
' attached to them, and links carry protocol and port. Kubernetes only (docker-compose is not documented).

actor "User" as user

node "Developer machine" <<device>> {
  node "Browser" as browser <<execution environment>>
  node "kubectl port-forward\n(start.sh)" as forward <<process>>
  artifact "searchv2-search-api:1.0.1\nsearchv2-blazor:1.0.1\nsearchv2-indexer:1.0.1\n(built locally with Docker)" as localimages <<image>>
}

node "Minikube node (profile searchv2: 1 node, 4 CPU, 6 GiB)" as minikube <<device>> {

  node "Namespace: searchv2" as nsapp <<namespace>> {
    node "Pod: blazor (1 replica)" as blazorpod <<pod>> {
      node "blazor" as blazor <<container>>
      artifact "searchv2-blazor:1.0.1" as blazorimg <<image>>
    }
    node "Service: blazor\n(NodePort 8080)" as blazorsvc <<service>>
    node "Pods: search-api (2 replicas)\nRollingUpdate maxSurge 1, maxUnavailable 0\nprobes: GET /healthz" as apipod <<pod>> {
      node "search-api\n(ASP.NET Core, :8080)" as api <<container>>
      artifact "searchv2-search-api:1.0.1" as apiimg <<image>>
    }
    node "Service: search-api\n(ClusterIP 8080)" as apisvc <<service>>
    node "Job: indexer (one-shot)\npipeline stage 1: publishes the documents,\nwaits until they are stored" as indexerpod <<pod>> {
      node "indexer (role pipeline)" as indexer <<container>>
      artifact "searchv2-indexer:1.0.1\n(one image, role chosen by argument)" as indexerimg <<image>>
    }
    node "Pods: indexer-tokenizer (2 replicas)\npipeline stage 2: reads a file, extracts its words" as tokpod <<pod>> {
      node "indexer (role tokenizer)" as tokenizer <<container>>
    }
    node "Pods: indexer-writer (2 replicas)\npipeline stage 3: stores a document in PostgreSQL" as writerpod <<pod>> {
      node "indexer (role writer)" as writer <<container>>
    }
    artifact "rabbitmq-credentials" as mqsecretapp <<secret>>
    folder "hostPath /data/searchv2-docs\n(document corpus, mounted read-only at /data/docs)" as docs <<volume>>
    artifact "feature-flags\n(featureflags.json mounted at /config)" as flags <<configmap>>
    artifact "postgresql-credentials" as pgsecret <<secret>>
  }

  node "Namespace: caching" as nscache <<namespace>> {
    node "Pod: redis (1 replica)" as redispod <<pod>> {
      node "redis (:6379)" as redis <<container>>
      artifact "redis:7-alpine" as redisimg <<image>>
    }
    artifact "redis-credentials" as redissecret <<secret>>
  }

  node "Namespace: messaging" as nsmq <<namespace>> {
    node "Pod: rabbitmq (1 replica)" as mqpod <<pod>> {
      node "rabbitmq (:5672 AMQP, :15672 UI, :15692 metrics)\nqueues: discovered, tokenized, failed" as mq <<container>>
      artifact "rabbitmq:4-management" as mqimg <<image>>
    }
    artifact "rabbitmq-credentials" as mqsecret <<secret>>
  }

  node "Namespace: database" as nsdb <<namespace>> {
    node "StatefulSet pod: postgresql-db-0\n(Helm release, Bitnami chart 18.12.17)" as pgpod <<pod>> {
      node "postgresql (:5432)\ndatabase searchengine, user searcher" as pg <<container>>
      artifact "bitnami/postgresql" as pgimg <<image>>
    }
    database "PersistentVolumeClaim 2 GiB\n(survives pod replacement)" as pvc <<volume>>
  }

  node "Namespace: devops (observability, emptyDir storage)" as nsops <<namespace>> {
    node "otel-collector\n(:4317 gRPC, :4318 HTTP, :8889 metrics)" as otel <<container>>
    node "prometheus (:9090)" as prom <<container>>
    node "loki (:3100)" as loki <<container>>
    node "grafana (:3000)\nprovisioned dashboard SearchV2" as grafana <<container>>
  }
}

' --- user access (through port-forwards started by start.sh)
user --> browser
browser --> forward : "HTTP localhost:5080\nHTTP localhost:3000"
forward --> blazorsvc : "5080 -> 8080"
forward --> grafana : "3000 -> 3000"
blazorsvc --> blazor : HTTP 8080
blazor --> apisvc : "HTTP/JSON 8080\nPOST /api/search"
apisvc --> api : HTTP 8080 (load balanced)

' --- data access
api --> pg : "TCP 5432 (SQL, read-only use)\nusername searcher"
indexer --> pg : "TCP 5432 (SQL: reset schema, count)"
writer --> pg : "TCP 5432 (SQL, one transaction per document)"
indexer --> mq : "AMQP 5672\npublish DocumentDiscovered"
tokenizer --> mq : "AMQP 5672\nconsume DocumentDiscovered,\npublish DocumentTokenized"
writer --> mq : "AMQP 5672\nconsume DocumentTokenized"
api --> redis : "TCP 6379 (Redis, cache-aside)\nflag SearchCache"
api ..> docs : read-only mount
indexer ..> docs : read-only mount
tokenizer ..> docs : read-only mount
pg ..> pvc : data directory
api ..> flags : mounted file /config
api ..> pgsecret : env SEARCH_DB_PASSWORD
indexer ..> pgsecret : env SEARCH_DB_PASSWORD
writer ..> pgsecret : env SEARCH_DB_PASSWORD
indexer ..> mqsecretapp : env RABBITMQ_PASSWORD
tokenizer ..> mqsecretapp : env RABBITMQ_PASSWORD
writer ..> mqsecretapp : env RABBITMQ_PASSWORD
mq ..> mqsecret : default password
api ..> redissecret : env REDISPASSWORD
redis ..> redissecret : password file

' --- observability
api --> otel : "OTLP gRPC 4317\nmetrics + logs"
blazor --> otel : "OTLP gRPC 4317\nmetrics + logs"
prom --> otel : "scrape :8889 every 15 s"
prom --> mq : "scrape :15692 /metrics/detailed\n(queue depth, consumers)"
otel --> loki : "OTLP/HTTP logs"
grafana --> prom : PromQL
grafana --> loki : LogQL

' --- how the artifacts got there
localimages ..> blazorimg : "minikube image load\n(imagePullPolicy: Never)"
localimages ..> apiimg
localimages ..> indexerimg
localimages ..> mqimg : "docker pull, then minikube image load"

@enduml
