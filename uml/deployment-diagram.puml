@startuml deployment-diagram
title SearchV2 - UML deployment diagram (Kubernetes on Minikube)
skinparam nodesep 40
skinparam ranksep 50

' Notation follows Modul 7 "Miljoebeskrivelser": nodes are runtime environments, <<container>> are
' runtime units, <<image>> are the deployed artifacts, <<volume>>/<<configmap>>/<<secret>> are data
' attached to them, and links carry protocol and port. Kubernetes only (docker-compose is not documented).

actor "User" as user

node "Developer machine" <<device>> {
  node "Browser" <<execution environment>> as browser
  node "kubectl port-forward\n(start.sh)" <<process>> as forward
  artifact "searchv2-search-api:1.0.1\nsearchv2-blazor:1.0.1\nsearchv2-indexer:1.0.1\n(built locally with Docker)" <<image>> as localimages
}

node "Minikube node (profile searchv2: 1 node, 4 CPU, 6 GiB)" <<device>> as minikube {

  node "Namespace: searchv2" <<namespace>> as nsapp {
    node "Pod: blazor (1 replica)" <<pod>> as blazorpod {
      node "blazor" <<container>> as blazor
      artifact "searchv2-blazor:1.0.1" <<image>> as blazorimg
    }
    node "Service: blazor\n(NodePort 8080)" <<service>> as blazorsvc
    node "Pods: search-api (2 replicas)\nRollingUpdate maxSurge 1, maxUnavailable 0\nprobes: GET /healthz" <<pod>> as apipod {
      node "search-api\n(ASP.NET Core, :8080)" <<container>> as api
      artifact "searchv2-search-api:1.0.1" <<image>> as apiimg
    }
    node "Service: search-api\n(ClusterIP 8080)" <<service>> as apisvc
    node "Job: indexer (one-shot)" <<pod>> as indexerpod {
      node "indexer" <<container>> as indexer
      artifact "searchv2-indexer:1.0.1" <<image>> as indexerimg
    }
    folder "hostPath /data/searchv2-docs\n(document corpus, mounted read-only at /data/docs)" <<volume>> as docs
    artifact "feature-flags\n(featureflags.json mounted at /config)" <<configmap>> as flags
    artifact "postgresql-credentials" <<secret>> as pgsecret
  }

  node "Namespace: caching" <<namespace>> as nscache {
    node "Pod: redis (1 replica)" <<pod>> as redispod {
      node "redis (:6379)" <<container>> as redis
      artifact "redis:7-alpine" <<image>> as redisimg
    }
    artifact "redis-credentials" <<secret>> as redissecret
  }

  node "Namespace: database" <<namespace>> as nsdb {
    node "StatefulSet pod: postgresql-db-0\n(Helm release, Bitnami chart 18.12.17)" <<pod>> as pgpod {
      node "postgresql (:5432)\ndatabase searchengine, user searcher" <<container>> as pg
      artifact "bitnami/postgresql" <<image>> as pgimg
    }
    database "PersistentVolumeClaim 2 GiB\n(survives pod replacement)" <<volume>> as pvc
  }

  node "Namespace: devops (observability, emptyDir storage)" <<namespace>> as nsops {
    node "otel-collector\n(:4317 gRPC, :4318 HTTP, :8889 metrics)" <<container>> as otel
    node "prometheus (:9090)" <<container>> as prom
    node "loki (:3100)" <<container>> as loki
    node "grafana (:3000)\nprovisioned dashboard SearchV2" <<container>> as grafana
  }
}

' --- user access (through port-forwards started by start.sh)
user --> browser
browser --> forward : "HTTP localhost:5080\nHTTP localhost:3000"
forward --> blazorsvc : "5080 -> 8080"
forward --> grafana : "3000 -> 3000"
blazorsvc --> blazor : HTTP 8080
blazor --> apisvc : "HTTP/JSON 8080\nPOST /api/search"
apisvc --> api : HTTP 8080 (load balanced)

' --- data access
api --> pg : "TCP 5432 (SQL, read-only use)\nusername searcher"
indexer --> pg : "TCP 5432 (SQL, write)"
api --> redis : "TCP 6379 (Redis, cache-aside)\nflag SearchCache"
api ..> docs : read-only mount
indexer ..> docs : read-only mount
pg ..> pvc : data directory
api ..> flags : mounted file /config
api ..> pgsecret : env SEARCH_DB_PASSWORD
indexer ..> pgsecret : env SEARCH_DB_PASSWORD
api ..> redissecret : env REDISPASSWORD
redis ..> redissecret : password file

' --- observability
api --> otel : "OTLP gRPC 4317\nmetrics + logs"
blazor --> otel : "OTLP gRPC 4317\nmetrics + logs"
prom --> otel : "scrape :8889 every 15 s"
otel --> loki : "OTLP/HTTP logs"
grafana --> prom : PromQL
grafana --> loki : LogQL

' --- how the artifacts got there
localimages ..> blazorimg : "minikube image load\n(imagePullPolicy: Never)"
localimages ..> apiimg
localimages ..> indexerimg

@enduml
